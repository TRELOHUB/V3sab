-- Lua Script for Roblox GUI with Blue Theme, Animated Orbs, and Key Input System

-- Services
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- GUI Setup
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BlueOrbGUI"
screenGui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 400, 0, 300)
frame.Position = UDim2.new(0.5, -200, 0.5, -150)
frame.BackgroundColor3 = Color3.fromRGB(0, 102, 204)  -- Blue theme
frame.BorderSizePixel = 0
frame.Parent = screenGui

-- Key System Label
local keyLabel = Instance.new("TextLabel")
keyLabel.Size = UDim2.new(1, 0, 0, 50)
keyLabel.Position = UDim2.new(0, 0, 0, 0)
keyLabel.BackgroundTransparency = 1
keyLabel.TextColor3 = Color3.new(1,1,1)
keyLabel.Text = "Press [E] to collect key"
keyLabel.Font = Enum.Font.SourceSansBold
keyLabel.TextSize = 24
keyLabel.Parent = frame

-- Orbs Container
local orbContainer = Instance.new("Frame")
orbContainer.Size = UDim2.new(1, 0, 1, -50)
orbContainer.Position = UDim2.new(0, 0, 0, 50)
orbContainer.BackgroundTransparency = 1
orbContainer.Parent = frame

-- Function to create animated orbs
local function createOrb(position)
    local orb = Instance.new("Frame")
    orb.Size = UDim2.new(0, 30, 0, 30)
    orb.Position = position
    orb.AnchorPoint = Vector2.new(0.5, 0.5)
    orb.BackgroundColor3 = Color3.fromRGB(0, 204, 255)
    orb.BorderSizePixel = 0
    orb.Parent = orbContainer
    orb.ClipsDescendants = false

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0.5, 0)
    uiCorner.Parent = orb

    -- Animation loop
    local tweenInfo = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
    local tween = TweenService:Create(orb, tweenInfo, {Position = UDim2.new(math.random(), 0, math.random(), 0)})
    tween:Play()
end

-- Create multiple orbs
for i = 1, 8 do
    createOrb(UDim2.new(math.random(), 0, math.random(), 0))
end

-- Simple Key System
local keyCollected = false
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.E and not keyCollected then
        keyCollected = true
        keyLabel.Text = "Key Collected!"
        -- Add additional logic for key usage here
    end
end)

-- Usage Example: This GUI appears automatically for the player
print("Blue GUI with animated orbs is now active, press [E] to collect the key.")
