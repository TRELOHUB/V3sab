-- Key System
local validKey = "TRELOHUB"  -- Define the key
local enteredKey = ""  -- User input for key

-- Display a prompt for key input
local UserInputService = game:GetService("UserInputService")
local function askForKey()
    local inputBox = Instance.new("TextBox")
    inputBox.Size = UDim2.new(0, 300, 0, 50)
    inputBox.Position = UDim2.new(0.5, -150, 0.5, -25)
    inputBox.Text = "Enter Key..."
    inputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    inputBox.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    inputBox.Parent = game.Players.LocalPlayer.PlayerGui:WaitForChild("ScreenGui")
    
    local function onKeySubmit()
        enteredKey = inputBox.Text
        if enteredKey == validKey then
            game.StarterGui:SetCore("SendNotification", {
                Title = "Key Accepted",
                Text = "Access granted to Steal a Brainrot v3.3 features.",
                Duration = 5
            })
            inputBox:Destroy()  -- Remove the input box after successful entry
            loadFeatures()
        else
            game.StarterGui:SetCore("SendNotification", {
                Title = "Invalid Key",
                Text = "Please enter the correct key to access the script.",
                Duration = 5
            })
        end
    end

    inputBox.FocusLost:Connect(function()
        onKeySubmit()
    end)
end

askForKey()

